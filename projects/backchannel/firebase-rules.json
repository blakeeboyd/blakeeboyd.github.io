{
  "rules": {
    "backchannel": {

      "_rooms": {
        ".read": true,
        ".write": true,
        "$roomKey": {
          ".validate": "$roomKey.matches(/^[a-z0-9-]{1,40}$/) && (!newData.exists() || newData.hasChildren(['ts','createdBy']))",
          "ts":           { ".validate": "newData.val() == now || (newData.isNumber() && newData.val() <= now + 5000)" },
          "createdBy":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "label":        { ".validate": "newData.isString() && newData.val().length <= 80" },
          "passwordHash": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
          "$other":       { ".validate": false }
        }
      },

      "$room": {
        ".read": true,
        ".validate": "$room.matches(/^[a-z0-9-]{1,40}$/)",

        "messages": {
          ".write": "$room == 'default' || root.child('backchannel').child('_rooms').child($room).exists()",
          "$msgId": {
            ".validate": "newData.hasChildren(['name','text','ts','deviceId']) && newData.child('deviceId').isString() && !root.child('backchannel').child($room).child('bans').child(newData.child('deviceId').val()).exists() && (root.child('backchannel').child($room).child('locked').val() != true || newData.child('name').val() == 'Blake')",
            "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "text":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "ts":       { ".validate": "newData.val() == now || (newData.isNumber() && newData.val() <= now + 5000)" },
            "deviceId": { ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 80" },
            "$other":   { ".validate": false }
          }
        },

        "adminSession": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['token','ts']) || !newData.exists()",
          "token": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "ts":    { ".validate": "newData.val() == now || (newData.isNumber() && newData.val() <= now + 5000)" },
          "$other": { ".validate": false }
        },

        "bans": {
          ".read": true,
          "$deviceId": {
            ".write": true,
            ".validate": "!newData.exists() || (newData.hasChildren(['ts','byName']))",
            "ts":     { ".validate": "newData.val() == now || (newData.isNumber() && newData.val() <= now + 5000)" },
            "byName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },

        "archives": {
          ".read": true,
          ".write": true,
          "$archiveId": {
            ".validate": "!newData.exists() || newData.hasChildren(['ts','archivedBy','count','messages'])",
            "ts":         { ".validate": "newData.val() == now || (newData.isNumber() && newData.val() <= now + 5000)" },
            "archivedBy": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "count":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "messages":   { ".validate": true },
            "$other": { ".validate": false }
          }
        },

        "locked": {
          ".read": true,
          ".write": true,
          ".validate": "newData.val() == true || !newData.exists()"
        },

        "subscriptions": {
          ".read": true,
          ".write": true,
          "$deviceId": {
            ".validate": "!newData.exists() || newData.hasChildren(['endpoint','ts'])",
            "endpoint": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1024" },
            "ts":       { ".validate": "newData.val() == now || (newData.isNumber() && newData.val() <= now + 5000)" },
            "keys": {
              "p256dh": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 256" },
              "auth":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 256" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },

        "pinned": {
          ".read": true,
          ".write": true,
          "$msgId": {
            ".validate": "!newData.exists() || newData.hasChildren(['ts','pinnedBy','name','text'])",
            "ts":       { ".validate": "newData.val() == now || (newData.isNumber() && newData.val() <= now + 5000)" },
            "pinnedBy": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "name":     { ".validate": "newData.isString() && newData.val().length <= 40" },
            "text":     { ".validate": "newData.isString() && newData.val().length <= 500" },
            "msgTs":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other":   { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
